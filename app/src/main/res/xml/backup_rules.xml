<?xml version="1.0" encoding="utf-8"?>
<!--
  Android Auto Backup (Android 6-11). Cards and their images are backed up; the encrypted
  DeepL key is not (its decryption key never leaves this phone, so a copy would be useless
  anyway). The dictionary lives in no_backup and caches are never backed up.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secrets.xml" />
</full-backup-content>
