<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same rules for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
